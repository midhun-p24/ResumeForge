# Copy to apps/web/.env.local. Never put the service key in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
RESUMEFORGE_APP_URL=http://localhost:3000
# Server-only release gate. Enable after custom SMTP and public acceptance checks pass.
RESUMEFORGE_REGISTRATION_ENABLED=false
# Companion: set locally, never send Codex credentials to the app.
# RESUMEFORGE_URL=http://localhost:3000
# RESUMEFORGE_CODEX_PATH=absolute path to codex executable (optional)
# RESUMEFORGE_TECTONIC_PATH=absolute path to tectonic executable (optional)
# RESUMEFORGE_VERCEL_BYPASS=local-only bypass credential for a protected preview (optional)
